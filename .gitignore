# Aerotelic C++/Unreal monorepo: core/ (OCCT geometry library, CMake) and
# ue/ (Unreal Engine 5.8 application). Only source is tracked; everything
# below is regenerated by the build scripts.

# ---- core (CMake) ----
/core/build/
# scratch file written by project_yaml_check
/core/tests/project_yaml_check_tmp.yaml

# ---- ue (Unreal) ----
/ue/Binaries/
/ue/Intermediate/
/ue/Saved/
/ue/DerivedDataCache/
/ue/Packaged/
/ue/Build/
/ue/.vs/
/ue/*.sln
/ue/*.VC.db
/ue/*.VC.opendb
# Build/test/package logs written next to the .bat files
/ue/*.txt

# ---- editors / OS ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
ue/.vsconfig
